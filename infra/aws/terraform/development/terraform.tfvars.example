# Replace the account placeholder before planning.
aws_region = "us-east-1"
aws_account_id = "000000000000"
project_name = "insurance"
environment = "development"
owner = "insurance_platform_team"

bedrock_rag_answer_model_id = "amazon.nova-lite-v1:0"
bedrock_embedding_model_id = "amazon.titan-embed-text-v2:0"
knowledge_bucket_versioning_enabled = false

# Offline ingestion defaults; the CLI consumes Terraform's ingestion_environment output.
knowledge_poc_prefix = "approved/aws_poc/"
knowledge_ingestion_timeout_seconds = 900
# Optional: attach scoped ingestion permissions to your existing operator IAM role.
# ingestion_runner_role_name = "insurance_ingestion_operator"

# Phase 1 monitoring is provisioned with the offline foundation.
log_retention_days = 14
# validation_runner_role_name = "insurance_validation_operator"

# Operator-only REST API. No Cognito users or JWT tokens.
enable_query_api = false
index_validation_passed = false
# query_operator_arn = "arn:aws:iam::000000000000:user/YOUR_OPERATOR"
# query_lambda_zip = "/absolute/path/to/query.zip"
# query_lambda_handler = "query.handler"
query_timeout_seconds = 28
query_max_tokens = 512
