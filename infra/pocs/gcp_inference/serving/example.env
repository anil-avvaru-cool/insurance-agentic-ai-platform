# Copy to .env in this directory; replace every placeholder. No secrets required
# for the public Qwen model. Get the digest from your reviewed image registry.
VLLM_IMAGE=vllm/vllm-openai@sha256:REPLACE_WITH_64_HEX_DIGEST
MODEL_COMMIT=REPLACE_WITH_40_HEX_HUGGING_FACE_COMMIT
TOKENIZER_COMMIT=REPLACE_WITH_40_HEX_HUGGING_FACE_COMMIT
GPU_POOL=gpu
