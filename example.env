AUTO_RULES_PATH=config/business_rules/auto_synthetic_v1.json
APP_MODE=synthetic_local
APP_DB_PATH=local_app.sqlite3
CORE_DB_PATH=local_core.sqlite3
FIXTURES_PATH=tests/fixtures/local_fixtures.json
LOCAL_IDENTITIES_JSON='{"local_customer_one_token":{"subject":"customer_one","role":"customer"},"local_customer_two_token":{"subject":"customer_two","role":"customer"},"local_employee_token":{"subject":"employee_one","role":"employee"}}'

CATALOGS_PATH=config/business_rules/local_catalogs_v1.json
CHECKPOINT_DB_PATH=local_checkpoints.sqlite3
CHECKPOINT_BACKEND=sqlite
# Required only when CHECKPOINT_BACKEND=postgres; supply through secret delivery.
CHECKPOINT_POSTGRES_DSN=
# Isolated synthetic test database; the evaluation runner creates tables.
CHECKPOINT_TEST_POSTGRES_DSN=
# Explicit disabled mode keeps the structured demonstration offline.
# Set bedrock and configure an AWS profile/role to enable natural-language interpretation.
LLM_PROVIDER=disabled
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=2000

# AWS development probes (AWS credentials come from the standard profile/role chain).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
MODEL_MAX_TOKENS=512
MODEL_TEMPERATURE=0
KNOWLEDGE_RESULT_COUNT=3
KNOWLEDGE_INGESTION_TIMEOUT_SECONDS=900
BEDROCK_KNOWLEDGE_BASE_ID=replace_from_terraform_output
BEDROCK_DATA_SOURCE_ID=replace_from_terraform_output
AGENTCORE_RUNTIME_ARN=replace_from_terraform_output

# Offline POC ingestion; --terraform-dir reads these and the IDs above from outputs.
KNOWLEDGE_BUCKET=replace_from_terraform_output
KNOWLEDGE_POC_PREFIX=approved/aws_poc/

# Query Lambda evidence limits and optional operator evaluation capture.
QUERY_MAX_PASSAGE_CHARS=6000
QUERY_MAX_CONTEXT_CHARS=24000
QUERY_CAPTURE_ENABLED=false
QUERY_CAPTURE_BUCKET=replace_from_terraform_output
QUERY_CAPTURE_PREFIX=captures/
# Terraform supplies the deployed ZIP hash to Lambda.
QUERY_DEPLOYMENT_ID=replace_with_deployed_zip_hash

# Offline Bedrock judge preparation. Fill explicit bounds/rates before prepare.
# prepare/export/reserve/summarize are offline; capture/upload/submit/status/collect use AWS.
JUDGE_REGION=us-east-1
JUDGE_DEPLOYMENT_ID=replace_with_deployed_zip_hash
JUDGE_MODEL_ID=replace_with_answer_model_id
JUDGE_KNOWLEDGE_BASE_ID=replace_with_knowledge_base_id
JUDGE_EVALUATOR_MODEL_ID=replace_with_supported_evaluator_id
JUDGE_CUSTOM_EVALUATOR_MODEL_ID=replace_with_supported_custom_evaluator_id
JUDGE_RAG_SOURCE_ID=insurance_api
JUDGE_EVALUATION_ROLE_ARN=replace_with_evaluation_role_arn
JUDGE_DATASET_S3_URI=s3://replace_with_evaluation_bucket/datasets/baseline.jsonl
JUDGE_OUTPUT_S3_URI=s3://replace_with_evaluation_bucket/results/
JUDGE_MAX_AGE_SECONDS=86400
JUDGE_PRICING_DATE=
JUDGE_PRICING_SOURCE=
JUDGE_BUDGET_USD=
JUDGE_SAFETY_MULTIPLIER=
JUDGE_SUPPORTING_COST_BOUND_USD=
JUDGE_CAPTURE_INPUT_TOKEN_BOUND=
JUDGE_CAPTURE_OUTPUT_TOKEN_BOUND=
# Judge input bound must include context, references, and per-metric prompt overhead.
JUDGE_JUDGE_INPUT_TOKEN_BOUND=
JUDGE_JUDGE_OUTPUT_TOKEN_BOUND=
JUDGE_CAPTURE_INPUT_USD_PER_MILLION=
JUDGE_CAPTURE_OUTPUT_USD_PER_MILLION=
JUDGE_JUDGE_INPUT_USD_PER_MILLION=
JUDGE_JUDGE_OUTPUT_USD_PER_MILLION=

# Separate custom evaluator rates/bounds, including the custom prompt.
JUDGE_CUSTOM_JUDGE_INPUT_TOKEN_BOUND=
JUDGE_CUSTOM_JUDGE_OUTPUT_TOKEN_BOUND=
JUDGE_CUSTOM_JUDGE_INPUT_USD_PER_MILLION=
JUDGE_CUSTOM_JUDGE_OUTPUT_USD_PER_MILLION=
